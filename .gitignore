# =============================================================================
# AWS Data Engineer Workshop - .gitignore
# =============================================================================

# --- Credenciais e configurações sensíveis ---
.env
.env.*
*.pem
*.key
credentials
*_credentials.*

# --- Progresso local do usuário (nunca versionar) ---
progress/*
!progress/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# --- Docker ---
docker-compose.override.yml

# --- IDEs e sistema ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Logs e temporários ---
*.log
tmp/
