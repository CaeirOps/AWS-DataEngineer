# =============================================================================
# AWS Data Engineer Workshop - .gitignore
# =============================================================================

# --- Credenciais e configurações sensíveis ---
.env
.env.*
*.pem
*.key
credentials
*_credentials.*
# Código-fonte e testes de credenciais temporárias não são segredos
!host_credentials.py
!tests/security/test_*_credentials.py

# --- Progresso local do usuário (nunca versionar) ---
progress/*
!progress/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# --- Docker ---
docker-compose.override.yml

# --- IDEs e sistema ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Logs e temporários ---
*.log
tmp/
# --- Lock do ProgressStore ---
*.lock

# --- Estado local de execução do Kiro (histórico de tarefas desta máquina) ---
.kiro/specs/**/tasks.meta.json
