# Regras para IAM dos labs: nenhum statement Allow com Action "*" e Resource "*" juntos.
let politicas = Resources.*[ Type in ['AWS::IAM::Policy', 'AWS::IAM::ManagedPolicy'] ]
let roles = Resources.*[ Type == 'AWS::IAM::Role' ]

rule iam_sem_admin_total_em_politicas when %politicas !empty {
    %politicas.Properties.PolicyDocument.Statement[ Effect == 'Allow' Action == '*' ] {
        Resource != '*'
    }
}

rule iam_sem_admin_total_em_roles when %roles !empty {
    %roles.Properties.Policies[*].PolicyDocument.Statement[ Effect == 'Allow' Action == '*' ] {
        Resource != '*'
    }
}
